---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { url } from "../lib/url";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="ugu-logs" description="AI notes and projects, written up as I go.">
  {
    posts.length === 0 ? (
      <p class="empty-state">No posts yet — check back soon.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <span class="post-date">
              {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
            </span>
            <a class="post-title" href={url(`blog/${post.id}/`)}>
              {post.data.title}
            </a>
            <p class="post-description">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <p class="post-tags">{post.data.tags.join(" · ")}</p>
            )}
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
